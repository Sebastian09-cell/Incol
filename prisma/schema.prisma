generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Typestatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum Typepaidmethod {
  TRANSFER
  CASH
  NEQUI
  DAVIPLATA
  OTRO
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String @unique
  password String

  clients  Client[]
  invoices Invoice[]
}

model Client {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  email  String?
  phone  String?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  invoices Invoice[]
}

model Invoice {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  totalAmount Int
  description String?
  status      Typestatus
  createdAt   DateTime   @default(now())
  dueDate     DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id])

  payments Payment[]

  @@index([userId])
  @@index([clientId])
}

model Payment {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount    Int
  paidAt    DateTime       @default(now())
  paymethod Typepaidmethod

  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}